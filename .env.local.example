NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Required to sign private site photos for the public client portal.
# Never expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL used for auth email redirects, metadata, and quotation links.
# Local development:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production / email confirmation testing:
NEXT_PUBLIC_APP_URL=https://builtpilot-web.vercel.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=BuildPilot <you@gmail.com>

# Server-only BuildPilot AI provider. Never expose these with NEXT_PUBLIC_.
# Compatible with OpenAI and other OpenAI-compatible chat completion APIs.
AI_PROVIDER_API_KEY=your-ai-provider-api-key
AI_MODEL=gpt-4o-mini
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# Server-only WhatsApp Business Cloud API (Meta) credentials.
# Never expose these with NEXT_PUBLIC_.
# Set WHATSAPP_PROVIDER=mock for local development without Meta credentials.
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Optional Graph API version override
# WHATSAPP_API_VERSION=v21.0
